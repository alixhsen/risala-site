# Copied to .env by `npm run setup` (which also fills in JWT_SECRET).

PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# --- Microsoft SQL Server ---
# Two ways to connect:
#
# 1) SQL Server Authentication (a SQL login, e.g. sa) - set DB_USER/DB_PASSWORD
#    below. SQL Server needs TCP/IP enabled and "SQL Server and Windows
#    Authentication mode" turned on for this.
# 2) Your own Windows login - leave DB_USER and DB_PASSWORD both empty. This is
#    the only option for LocalDB, e.g. DB_SERVER=(localdb)\MSSQLLocalDB
#    (requires "ODBC Driver 17 for SQL Server" to be installed, which ships
#    with SSMS). DB_PORT/DB_INSTANCE/DB_ENCRYPT are ignored in this mode.
DB_SERVER=localhost
DB_PORT=1433
# For a named instance such as SQLEXPRESS, set DB_INSTANCE and leave DB_PORT empty
# (the "SQL Server Browser" service must be running).
DB_INSTANCE=
DB_NAME=RisalaSite
DB_USER=sa
DB_PASSWORD=
DB_ENCRYPT=false

# --- Auth ---
JWT_SECRET=
# Optional: password for the first admin account created by `npm run db:init`.
# If empty, a random one is generated and printed once.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
