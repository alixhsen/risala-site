# Copied to .env by `npm run setup` (which also fills in JWT_SECRET).

PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# --- Database (SQLite) ---
# A single file, created by `npm run db:init` (server/scripts/init-sqlite.js).
# Relative paths resolve from the server/ folder; leave unset for the default.
DB_FILE=data/risala.db

# --- Auth ---
JWT_SECRET=
# Optional: password for the first admin account created by `npm run db:init`.
# If empty, a random one is generated and printed once.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
